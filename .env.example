# ---- CouchDB (Obsidian LiveSync) ----
COUCHDB_URI=
COUCHDB_DATABASE=
COUCHDB_USER=
COUCHDB_PASSWORD=

# Obsidian 側で E2E 暗号化を有効にしている場合のみ true + パスフレーズ
E2EE_ENABLED=false
E2EE_PASSPHRASE=

# ---- Open WebUI ----
# Railway 内部通信を使う場合: http://open-webui.railway.internal:8080
OPEN_WEBUI_URL=
# Settings -> Account -> API Keys で発行 (sk-...)
OPEN_WEBUI_API_KEY=
# Workspace で KB を開いたときの URL 末尾の UUID
OIKB_KB_ID=

# ---- 動作パラメータ ----
VAULT_PATH=/vault
SYNC_INTERVAL_SECONDS=30
INITIAL_WAIT=90
OIKB_DEBOUNCE=60

WRITE_API_SECRET=好きなランダム文字列(例: openssl rand -hex 16 で生成)
WRITE_API_PORT=8090